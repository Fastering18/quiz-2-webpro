Type: CDM
Title: Sistem Web Fullstack Portal & Classroom ITS

Entities:
- Pengguna [x: 10, y: 465] {
    User ID: varchar(16) [identifier];
    Username: varchar(30) [mandatory];
    Nama Lengkap: varchar(100) [mandatory];
    Email: varchar(120) [mandatory];
    Password Hash: varchar(255) [mandatory];
    Role: varchar(20) [mandatory];
    Foto Profil Key: varchar(255);
    Nomor Telepon: varchar(20);
    Alamat Rumah: varchar(255)
  }

- Mahasiswa [x: 310, y: 89] {
    NRP: varchar(14) [identifier];
    User ID: varchar(16) [mandatory];
    NIP Wali: varchar(18) [mandatory];
    Departemen: varchar(80) [mandatory];
    Semester Aktif: int [M];
    Status: varchar(20) [M]
  }

- Dosen [x: -282, y: 89] {
    NIP: varchar(18) [identifier];
    User ID: varchar(16) [mandatory];
    Departemen: varchar(80) [mandatory];
    Status: varchar(20) [M]
  }

- MataKuliah [x: -1090, y: 490] {
    Kode MK: varchar(10) [identifier];
    Nama MK: varchar(120) [mandatory];
    SKS: int [mandatory];
    Semester: int [M]
  }

- KRS [x: -270, y: -429] {
    KRS ID: varchar(16) [identifier];
    NRP: varchar(14) [mandatory];
    Semester: int [M];
    Semester Tahun: varchar(12) [mandatory];
    Status ACC: varchar(20) [M];
    Tanggal Cetak: date
  }

- DetailKRS [x: -1092, y: -429] {
    Detail ID: int [identifier];
    KRS ID: varchar(16) [mandatory];
    Kelas ID: varchar(12) [mandatory];
    Nilai Akhir: int
  }

- Classroom [x: -1090, y: 170] {
    Kelas ID: varchar(12) [identifier];
    Kode MK: varchar(10) [mandatory];
    NIP: varchar(18) [mandatory];
    Nama Kelas: varchar(60) [mandatory];
    Semester Tahun: varchar(12) [M];
    Kuota Kelas: int [M]
  }

- BagianKelas [x: -1640, y: -460] {
    Bagian ID: int [identifier];
    Kelas ID: varchar(12) [mandatory];
    Urutan: int [M];
    Judul Bagian: varchar(160) [mandatory];
    Judul Ringkasan: varchar(160);
    Konten Ringkasan: varchar(5000)
  }

- PengumumanClassroom [x: -1640, y: 220] {
    Pengumuman ID: int [identifier];
    Kelas ID: varchar(12) [mandatory];
    Konten: varchar(2000);
    Tanggal Unggah: date [M]
  }

- MateriKelas [x: -1640, y: -89] {
    Materi ID: int [identifier];
    Bagian ID: int [mandatory];
    Judul Materi: varchar(160) [mandatory];
    Nama File: varchar(255) [M];
    File Materi Key: varchar(255) [M];
    Ukuran File: int [M];
    Tanggal Unggah: date [M]
  }

- TugasKelas [x: -790, y: -160] {
    Tugas ID: int [identifier];
    Bagian ID: int [mandatory];
    Urutan: int [M];
    Judul Tugas: varchar(160) [mandatory];
    Deskripsi Tugas: varchar(2000);
    Format File: varchar(50);
    Tenggat Waktu: datetime [M]
  }

- PengumpulanTugas [x: -260, y: -160] {
    Submit ID: int [identifier];
    Tugas ID: int [mandatory];
    NRP: varchar(14) [mandatory];
    Nama File: varchar(255) [mandatory];
    File Jawaban Key: varchar(255) [mandatory];
    Ukuran File: int [M];
    Komentar: varchar(1000);
    Tanggal Kirim: datetime [M];
    Nilai Tugas: int
  }

- Perpustakaan [x: 643, y: 465] {
    Buku ID: varchar(12) [identifier];
    Judul Buku: varchar(200) [mandatory];
    Penulis: varchar(160) [mandatory];
    Tahun: int;
    Kategori: varchar(40) [M];
    Publisher ID: varchar(16);
    Nama File: varchar(255) [M];
    File Dokumen Key: varchar(255) [M];
    Ukuran File: int [M]
  }

- LaporanAdmin [x: -624, y: 465] {
    Tiket ID: varchar(16) [identifier];
    User ID: varchar(16) [mandatory];
    Kategori Modul: varchar(40) [mandatory];
    Judul Laporan: varchar(150) [mandatory];
    Deskripsi Kendala: varchar(2000) [M];
    Lampiran Nama File: varchar(255);
    Lampiran Bukti Key: varchar(255);
    Status Tiket: varchar(20) [M];
    Tanggal Lapor: datetime [M];
    Admin ID: varchar(16);
    Tanggapan Admin: varchar(255);
    Tanggal Tanggapan: datetime
  }

References:
- Pengguna.User ID - Mahasiswa.User ID: akun mahasiswa
- Pengguna.User ID - Dosen.User ID: akun dosen
- Dosen.NIP < Mahasiswa.NIP Wali: membimbing wali
- Mahasiswa.NRP < KRS.NRP: mengajukan rencana studi
- KRS.KRS ID < DetailKRS.KRS ID: memuat daftar kelas
- Classroom.Kelas ID < DetailKRS.Kelas ID: diikuti melalui
- MataKuliah.Kode MK < Classroom.Kode MK: membuka kelas
- Dosen.NIP < Classroom.NIP: mengampu kelas
- Classroom.Kelas ID < BagianKelas.Kelas ID: terbagi atas
- BagianKelas.Bagian ID < MateriKelas.Bagian ID: menyediakan materi
- BagianKelas.Bagian ID < TugasKelas.Bagian ID: memberikan tugas
- TugasKelas.Tugas ID < PengumpulanTugas.Tugas ID: menerima jawaban
- Mahasiswa.NRP < PengumpulanTugas.NRP: mengumpulkan tugas
- Pengguna.User ID < LaporanAdmin.User ID: mengirim laporan
- Pengguna.User ID < LaporanAdmin.Admin ID: menanggapi laporan
- PengumumanClassroom.Kelas ID > Classroom.Kelas ID: mengumumkan di kelas
- Perpustakaan.Publisher ID > Pengguna.User ID: mengunggah
