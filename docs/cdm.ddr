# CDM (Conceptual Data Model) - Portal & Classroom Quiz 2 WebPro
# Source of truth: database/migrations (final schema after 2026_10_26_130000).
# Foreign keys and technical columns (storage keys, tokens, sessions, cache, jobs)
# are not drawn here; see pdm.ddr. Relationships read: <one> < <many>.
# Optional sides: Perpustakaan -> Pengguna (penerbit, may be null),
# LaporanAdmin -> Pengguna (penanggap, null until an admin replies).
Type: CDM
Title: CDM - Portal & Classroom Quiz 2 WebPro

Entities:
- Pengguna {
    User ID: varchar(64) [identifier];
    Username: varchar(30) [mandatory];
    Nama Lengkap: varchar(100) [mandatory];
    Email: varchar(120) [mandatory];
    Kata Sandi: varchar(255) [mandatory];
    Role: varchar(20) [mandatory];
    Foto Profil: varchar(255);
    Nomor Telepon: varchar(20);
    Alamat Rumah: varchar(255)
  }

- Mahasiswa {
    NRP: varchar(32) [identifier];
    Departemen: varchar(80) [mandatory];
    Semester Aktif: int [mandatory];
    Status: varchar(20) [mandatory]
  }

- Dosen {
    NIP: varchar(32) [identifier];
    Departemen: varchar(80) [mandatory];
    Status: varchar(20) [mandatory]
  }

- MataKuliah {
    Kode MK: varchar(20) [identifier];
    Nama MK: varchar(120) [mandatory];
    SKS: int [mandatory];
    Semester: int [mandatory]
  }

- Classroom {
    Kelas ID: varchar(64) [identifier];
    Nama Kelas: varchar(60) [mandatory];
    Semester Tahun: varchar(12) [mandatory];
    Kuota Kelas: int [mandatory]
  }

- KRS {
    KRS ID: varchar(32) [identifier];
    Semester: int [mandatory];
    Semester Tahun: varchar(12) [mandatory];
    Status ACC: varchar(20) [mandatory];
    Tanggal Cetak: date
  }

- DetailKRS {
    Detail ID: bigint [identifier];
    Nilai Akhir: int
  }

- BagianKelas {
    Bagian ID: bigint [identifier];
    Urutan: int [mandatory];
    Judul Bagian: varchar(160) [mandatory];
    Judul Ringkasan: varchar(160);
    Konten Ringkasan: varchar(5000)
  }

- PengumumanClassroom {
    Pengumuman ID: bigint [identifier];
    Konten: varchar(2000);
    Tanggal Unggah: date [mandatory]
  }

- MateriKelas {
    Materi ID: bigint [identifier];
    Judul Materi: varchar(160) [mandatory];
    Nama File: varchar(255) [mandatory];
    Ukuran File: int [mandatory];
    Tanggal Unggah: date [mandatory]
  }

- TugasKelas {
    Tugas ID: bigint [identifier];
    Urutan: int [mandatory];
    Judul Tugas: varchar(160) [mandatory];
    Deskripsi Tugas: varchar(2000);
    Format File: varchar(50);
    Tenggat Waktu: datetime [mandatory]
  }

- PengumpulanTugas {
    Submit ID: bigint [identifier];
    Nama File: varchar(255) [mandatory];
    Ukuran File: int [mandatory];
    Komentar: varchar(1000);
    Tanggal Kirim: datetime [mandatory];
    Nilai Tugas: int;
    Terlambat: boolean [mandatory]
  }

- Perpustakaan {
    Buku ID: varchar(64) [identifier];
    Judul Buku: varchar(200) [mandatory];
    Penulis: varchar(160) [mandatory];
    Tahun: int;
    Kategori: varchar(40) [mandatory];
    Nama File: varchar(255) [mandatory];
    Ukuran File: int [mandatory]
  }

- LaporanAdmin {
    Tiket ID: varchar(64) [identifier];
    Kategori Modul: varchar(40) [mandatory];
    Judul Laporan: varchar(150) [mandatory];
    Deskripsi Kendala: varchar(2000) [mandatory];
    Lampiran Nama File: varchar(255);
    Status Tiket: varchar(20) [mandatory];
    Tanggal Lapor: datetime [mandatory];
    Tanggapan Admin: varchar(255);
    Tanggal Tanggapan: datetime
  }

Ref: Pengguna - Mahasiswa: berperan sebagai
Ref: Pengguna - Dosen: berperan sebagai
Ref: Dosen < Mahasiswa: membimbing sebagai wali
Ref: Dosen < Classroom: mengampu
Ref: MataKuliah < Classroom: dibuka menjadi
Ref: Mahasiswa < KRS: mengisi
Ref: KRS < DetailKRS: memuat
Ref: Classroom < DetailKRS: diikuti melalui
Ref: Classroom < PengumumanClassroom: memiliki pengumuman
Ref: Classroom < BagianKelas: terbagi atas
Ref: BagianKelas < MateriKelas: menyediakan
Ref: BagianKelas < TugasKelas: memberikan
Ref: TugasKelas < PengumpulanTugas: menerima
Ref: Mahasiswa < PengumpulanTugas: mengumpulkan
Ref: Pengguna < Perpustakaan: menerbitkan
Ref: Pengguna < LaporanAdmin: melaporkan
Ref: Pengguna < LaporanAdmin: menanggapi
