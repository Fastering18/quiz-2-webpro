# PDM (Physical Data Model) - PostgreSQL (Neon), generated by Laravel migrations.
# Source of truth: database/migrations, final schema (after 2026_10_26_130000_make_file_keys_nullable).
# Types are the real Postgres types: string(n) = varchar(n), id() = bigint identity,
# integer = int, dateTime/timestamp = timestamp(0), longText/mediumText = text.
#
# Constraints ddr cannot draw (all in the migrations):
#   composite UNIQUE   krs (nrp, semester_tahun); detail_krs (krs_id, kelas_id)
#   DEFAULT            pengumpulan_tugas.terlambat = false
#   ON DELETE CASCADE  detail_krs.krs_id; bagian_kelas.kelas_id; pengumuman_classroom.kelas_id;
#                      materi_kelas.bagian_id; tugas_kelas.bagian_id; pengumpulan_tugas.tugas_id
#   ON DELETE SET NULL perpustakaan.publisher_id; laporan_admin.admin_id
#   ON DELETE RESTRICT (default) all other foreign keys
#   INDEX              sessions(user_id), sessions(last_activity), cache(expiration),
#                      cache_locks(expiration), jobs(queue),
#                      personal_access_tokens(tokenable_type, tokenable_id), personal_access_tokens(expires_at)
#   Width quirks kept as migrated: krs.nrp is varchar(14) (mahasiswa.nrp is 32), detail_krs.kelas_id is varchar(12) (classroom.kelas_id is 64).
#
# Application tables: pengguna ... laporan_admin.
# SYSTEM tables (Laravel framework, no foreign keys): password_reset_tokens, sessions,
#   personal_access_tokens (Sanctum), cache, cache_locks, jobs.
#   password_reset_tokens.email matches pengguna.email and sessions.user_id matches pengguna.user_id
#   logically only (no FK constraint).
Type: PDM
Title: PDM - Portal & Classroom Quiz 2 WebPro (PostgreSQL)

Tables:
- pengguna {
    user_id: varchar(64) [pk];
    username: varchar(30) [unique, not null];
    nama_lengkap: varchar(100) [not null];
    email: varchar(120) [unique, not null];
    password_hash: varchar(255) [not null];
    role: varchar(20) [not null];
    foto_profil_key: varchar(255) [null];
    nomor_telepon: varchar(20) [null];
    alamat_rumah: varchar(255) [null]
  }

- dosen {
    nip: varchar(32) [pk];
    user_id: varchar(64) [fk, unique, not null];
    departemen: varchar(80) [not null];
    status: varchar(20) [not null]
  }

- mahasiswa {
    nrp: varchar(32) [pk];
    user_id: varchar(64) [fk, unique, not null];
    nip_wali: varchar(32) [fk, not null];
    departemen: varchar(80) [not null];
    semester_aktif: int [not null];
    status: varchar(20) [not null]
  }

- mata_kuliah {
    kode_mk: varchar(20) [pk];
    nama_mk: varchar(120) [not null];
    sks: int [not null];
    semester: int [not null]
  }

- classroom {
    kelas_id: varchar(64) [pk];
    kode_mk: varchar(20) [fk, not null];
    nip: varchar(32) [fk, not null];
    nama_kelas: varchar(60) [not null];
    semester_tahun: varchar(12) [not null];
    kuota_kelas: int [not null]
  }

- krs {
    krs_id: varchar(32) [pk];
    nrp: varchar(14) [fk, not null];
    semester: int [not null];
    semester_tahun: varchar(12) [not null];
    status_acc: varchar(20) [not null];
    tanggal_cetak: date [null]
  }

- detail_krs {
    detail_id: bigint [pk];
    krs_id: varchar(32) [fk, not null];
    kelas_id: varchar(12) [fk, not null];
    nilai_akhir: int [null]
  }

- bagian_kelas {
    bagian_id: bigint [pk];
    kelas_id: varchar(64) [fk, not null];
    urutan: int [not null];
    judul_bagian: varchar(160) [not null];
    judul_ringkasan: varchar(160) [null];
    konten_ringkasan: varchar(5000) [null]
  }

- pengumuman_classroom {
    pengumuman_id: bigint [pk];
    kelas_id: varchar(64) [fk, not null];
    konten: varchar(2000) [null];
    tanggal_unggah: date [not null]
  }

- materi_kelas {
    materi_id: bigint [pk];
    bagian_id: bigint [fk, not null];
    judul_materi: varchar(160) [not null];
    nama_file: varchar(255) [not null];
    file_materi_key: varchar(255) [null];
    ukuran_file: int [not null];
    tanggal_unggah: date [not null]
  }

- tugas_kelas {
    tugas_id: bigint [pk];
    bagian_id: bigint [fk, not null];
    urutan: int [not null];
    judul_tugas: varchar(160) [not null];
    deskripsi_tugas: varchar(2000) [null];
    format_file: varchar(50) [null];
    tenggat_waktu: timestamp [not null]
  }

- pengumpulan_tugas {
    submit_id: bigint [pk];
    tugas_id: bigint [fk, not null];
    nrp: varchar(32) [fk, not null];
    nama_file: varchar(255) [not null];
    file_jawaban_key: varchar(255) [null];
    ukuran_file: int [not null];
    komentar: varchar(1000) [null];
    tanggal_kirim: timestamp [not null];
    nilai_tugas: int [null];
    terlambat: boolean [not null]
  }

- perpustakaan {
    buku_id: varchar(64) [pk];
    judul_buku: varchar(200) [not null];
    penulis: varchar(160) [not null];
    publisher_id: varchar(64) [fk, null];
    tahun: int [null];
    kategori: varchar(40) [not null];
    nama_file: varchar(255) [not null];
    file_dokumen_key: varchar(255) [null];
    ukuran_file: int [not null]
  }

- laporan_admin {
    tiket_id: varchar(64) [pk];
    user_id: varchar(64) [fk, not null];
    kategori_modul: varchar(40) [not null];
    judul_laporan: varchar(150) [not null];
    deskripsi_kendala: varchar(2000) [not null];
    lampiran_nama_file: varchar(255) [null];
    lampiran_bukti_key: varchar(255) [null];
    status_tiket: varchar(20) [not null];
    tanggal_lapor: timestamp [not null];
    admin_id: varchar(64) [fk, null];
    tanggapan_admin: varchar(255) [null];
    tanggal_tanggapan: timestamp [null]
  }

# ---- System tables (framework) ----

- password_reset_tokens {
    email: varchar(255) [pk];
    token: varchar(255) [not null];
    created_at: timestamp [null]
  }

- sessions {
    id: varchar(255) [pk];
    user_id: varchar(64) [null];
    ip_address: varchar(45) [null];
    user_agent: text [null];
    payload: text [not null];
    last_activity: int [not null]
  }

- personal_access_tokens {
    id: bigint [pk];
    tokenable_type: varchar(255) [not null];
    tokenable_id: varchar(36) [not null];
    name: text [not null];
    token: varchar(64) [unique, not null];
    abilities: text [null];
    last_used_at: timestamp [null];
    expires_at: timestamp [null];
    created_at: timestamp [null];
    updated_at: timestamp [null]
  }

- cache {
    key: varchar(255) [pk];
    value: text [not null];
    expiration: bigint [not null]
  }

- cache_locks {
    key: varchar(255) [pk];
    owner: varchar(255) [not null];
    expiration: bigint [not null]
  }

- jobs {
    id: bigint [pk];
    queue: varchar(255) [not null];
    payload: text [not null];
    attempts: smallint [not null];
    reserved_at: int [null];
    available_at: int [not null];
    created_at: int [not null]
  }

Ref: pengguna.user_id - dosen.user_id
Ref: pengguna.user_id - mahasiswa.user_id
Ref: dosen.nip < mahasiswa.nip_wali
Ref: dosen.nip < classroom.nip
Ref: mata_kuliah.kode_mk < classroom.kode_mk
Ref: mahasiswa.nrp < krs.nrp
Ref: krs.krs_id < detail_krs.krs_id
Ref: classroom.kelas_id < detail_krs.kelas_id
Ref: classroom.kelas_id < bagian_kelas.kelas_id
Ref: classroom.kelas_id < pengumuman_classroom.kelas_id
Ref: bagian_kelas.bagian_id < materi_kelas.bagian_id
Ref: bagian_kelas.bagian_id < tugas_kelas.bagian_id
Ref: tugas_kelas.tugas_id < pengumpulan_tugas.tugas_id
Ref: mahasiswa.nrp < pengumpulan_tugas.nrp
Ref: pengguna.user_id < perpustakaan.publisher_id
Ref: pengguna.user_id < laporan_admin.user_id
Ref: pengguna.user_id < laporan_admin.admin_id
